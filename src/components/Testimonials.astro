---
import Icon from './Icon.astro';
import { initials, testimonials } from '../data/testimonials';
---
<section class="testimonials section-light" id="depoimentos">
  <div class="wrap">
    <div class="section-top">
      <div>
        <span class="eyebrow">05 / QUEM JÁ VENDE AP</span>
        <h2>Sacoleiras que <em>confiam</em></h2>
      </div>
      <div class="carousel-controls">
        <button class="carousel-button" data-carousel-pause aria-controls="testimonial-track" aria-pressed="false" aria-label="Pausar a rotação dos depoimentos"><Icon name="pause" /></button>
        <button class="carousel-button" data-carousel-prev aria-controls="testimonial-track" aria-label="Depoimento anterior"><Icon name="arrow" class="icon icon-flip" /></button>
        <button class="carousel-button" data-carousel-next aria-controls="testimonial-track" aria-label="Próximo depoimento"><Icon name="arrow" /></button>
      </div>
    </div>
    {/* Depoimentos em src/data/testimonials.ts. [PREENCHER: os atuais são mock] */}
    <ul id="testimonial-track" class="testimonial-list" role="list" aria-label="Depoimentos de sacoleiras" tabindex="0">
      {testimonials.map((item, index) => (
        <li class="testimonial-card" aria-label={`Depoimento ${index + 1} de ${testimonials.length}`}>
          <blockquote>“{item.quote}”</blockquote>
          <div class="testimonial-author">
            {item.photo
              ? <img src={`/assets/depoimentos/${item.photo}`} alt="" width="56" height="56" loading="lazy">
              : <span class="testimonial-avatar" aria-hidden="true">{initials(item.name)}</span>}
            <div>
              <strong>{item.name}</strong>
              <span>{item.city}</span>
              <span>{item.since}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="carousel-dots" id="testimonial-dots" role="group" aria-label="Escolher depoimento"></div>
  </div>
</section>
