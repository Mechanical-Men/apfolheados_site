---
import Icon from './Icon.astro';
import { categoryLabel, productTitle, type Product } from '../data/products';
import { shareMessage, whatsappUrl } from '../lib/catalog';
interface Props { product: Product }
const { product } = Astro.props;
const title = productTitle(product);
const photo = product.primaryPhoto ?? product.photos[0];
const worn = product.primaryPhoto ? product.hoverPhoto : product.photos[1];
---
<article class:list={['product-card', { 'has-worn': worn }]} data-product={product.code}>
  <div class="product-photo">
    <button class="photo-button" data-view={product.code} aria-label={`Ver detalhes de ${title}`}>
      <img src={photo!.card} alt={title} width="600" height="750" loading="lazy" decoding="async" />
      {/* Imagem de hover escolhida no AP Studio; independente da posição na galeria. */}
      {worn && <img class="photo-worn" data-src={worn.card} alt="" width="600" height="750" loading="lazy" decoding="async" />}
      <span class="photo-caption-hover">VER ESTE DETALHE ↗</span>
    </button>
  </div>
  <div class="product-meta">
    <div>
      <h3 class:list={{ 'is-code': !product.name }}>{title}</h3>
      <div class="product-code">
        <span>{product.name ? product.code : categoryLabel(product.category)}</span>
        <button class="copy-code" data-copy-code={product.code} aria-label={`Copiar referência ${product.code}`}>{product.name ? 'copiar' : 'copiar código'}</button>
      </div>
    </div>
    <button class="quick-arrow" data-view={product.code} aria-label={`Ver ${title}`}><Icon name="up-right" /></button>
  </div>
  <div class="product-actions">
    <a href={whatsappUrl(shareMessage(product))} target="_blank" rel="noopener noreferrer"><Icon name="message" />Compartilhar</a>
    <a href={photo!.download} download aria-label={`Baixar foto de ${title}`}><Icon name="download" /><span>Foto</span></a>
  </div>
</article>
