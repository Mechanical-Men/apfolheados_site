---
import Icon from './Icon.astro';
---
<section class="resources section-light" id="central">
  <div class="wrap">
    <div class="section-top">
      <div>
        <span class="eyebrow">04 / PARA QUEM LEVA A AP ADIANTE</span>
        <h2>Central da<br> <em>Sacoleira</em></h2>
      </div>
      <p class="section-intro">Fotos, mensagens prontas e dicas para você vender mais fácil.</p>
    </div>
    <div class="resource-list">
      <a href="#colecao" class="resource-row">
        <span class="resource-number">01</span>
        <h3>Fotos para compartilhar</h3>
        <p>Abra uma peça do mostruário e baixe a foto.</p>
        <Icon name="up-right" />
      </a>
      <button class="resource-row" data-resource="messages">
        <span class="resource-number">02</span>
        <h3>Uma mensagem para começar</h3>
        <p>Texto pronto para copiar e mandar para a sua cliente.</p>
        <Icon name="up-right" />
      </button>
      <button class="resource-row" data-resource="care">
        <span class="resource-number">03</span>
        <h3>Cuidado com as suas peças</h3>
        <p>Um guia simples para guardar e compartilhar.</p>
        <Icon name="up-right" />
      </button>
    </div>
  </div>
</section>
