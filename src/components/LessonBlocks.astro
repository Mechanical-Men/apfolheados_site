---
import Icon from './Icon.astro';
import type { LessonBlock } from '../data/reseller';
import { richText } from '../lib/reseller';
interface Props { blocks: readonly LessonBlock[] }
const { blocks } = Astro.props;
---
{blocks.map(block => {
  if (block.type === 'text') return <p class="block-text" set:html={richText(block.text)} />;
  if (block.type === 'heading') return <h2 class="block-heading">{block.text}</h2>;
  if (block.type === 'quote') return <blockquote class="block-quote">{block.text}</blockquote>;
  if (block.type === 'callout') return <aside class="block-callout"><strong>{block.label}</strong><p set:html={richText(block.text)} /></aside>;
  if (block.type === 'link') return <a class="block-link" href={block.href}>{block.label} <Icon name="arrow" /></a>;
  if (block.type === 'list') return <ul class="block-list">{block.items.map(item => <li set:html={richText(item)} />)}</ul>;
  if (block.type === 'flow') return <ol class="block-flow">{block.items.map(item => <li>{item}</li>)}</ol>;
  if (block.type === 'week') return <ul class="block-week">{block.items.map(item => <li><strong>{item.day}</strong><span>{item.text}</span></li>)}</ul>;
  if (block.type === 'table') return (
    <div class="block-table">
      <table>
        {block.head && <thead><tr>{block.head.map(cell => <th scope="col">{cell}</th>)}</tr></thead>}
        <tbody>{block.rows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td set:html={richText(cell)} />)}</tr>)}</tbody>
      </table>
    </div>
  );
  return (
    <div class:list={['block-cards', { 'is-list': block.layout === 'list' }]}>
      {block.items.map(item => (
        <article>
          {item.mark && <span class="card-mark">{item.mark}</span>}
          <div>
            <h3>{item.title}</h3>
            {item.text && <p set:html={richText(item.text)} />}
            {item.quote && <p class="card-quote">{item.quote}</p>}
            {item.note && <p class="card-note">{item.note}</p>}
          </div>
        </article>
      ))}
    </div>
  );
})}
