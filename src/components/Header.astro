---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import { instagramUrl } from '../config/brand';
---
<header class="header" id="topo">
  <div class="header-inner">
    <Brand />
    <nav id="navigation" aria-label="Navegação principal">
      <a href="#colecao">As peças</a>
      <a href="#revenda">Seja revendedora</a>
      <a href="#historia">A nossa história</a>
      <a href="#duvidas">Dúvidas</a>
    </nav>
    <div class="header-actions">
      <button class="icon-button" id="search-open" aria-label="Buscar uma peça">
        <Icon name="search" />
      </button>
      <a class="icon-button" href={instagramUrl} target="_blank" rel="noopener" aria-label="Instagram da AP Folheados">
        <Icon name="instagram" />
      </a>
      <button class="icon-button favorite-open" id="favorites-open" aria-label="Ver peças salvas">
        <Icon name="heart" />
        <span id="favorite-count" class="favorite-count" hidden>0</span>
      </button>
      <a href="#contato" class="header-cta">Vamos conversar <Icon name="up-right" /></a>
      <button class="menu-toggle" id="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Abrir menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
