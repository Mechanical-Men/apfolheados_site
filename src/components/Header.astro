---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
import { instagramUrl } from '../config/brand';
---
<header class="header" id="topo">
  <div class="header-inner">
    <Brand />
    <nav id="navigation" aria-label="Navegação principal">
      <a href="/catalogo" aria-current={Astro.url.pathname.startsWith('/catalogo') ? 'page' : undefined}>Catálogo</a>
      <a href="/seja-revendedora" aria-current={Astro.url.pathname.startsWith('/seja-revendedora') ? 'page' : undefined}>Seja revendedora</a>
      <a href="/revendedora" aria-current={Astro.url.pathname.startsWith('/revendedora') ? 'page' : undefined}>Área da revendedora</a>
      <a href="/#historia">A nossa história</a>
      <a href="/#duvidas">Dúvidas</a>
    </nav>
    <div class="header-actions">
      <a class="icon-button" href={instagramUrl} target="_blank" rel="noopener" aria-label="Instagram da AP Folheados">
        <Icon name="instagram" />
      </a>
      <a href="/#contato" class="header-cta">Vamos conversar <Icon name="up-right" /></a>
      <button class="menu-toggle" id="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Abrir menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
